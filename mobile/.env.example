# Copie para .env e ajuste. Variáveis EXPO_PUBLIC_* são embutidas no bundle no build (não coloque segredos nelas).
# URL pública da API (sem barra final). Ex.: https://api.seudominio.com.br
EXPO_PUBLIC_API_URL=http://localhost:8080
# Chave do Google Maps (Android/iOS). Restrinja-a por package/bundle no Google Cloud Console.
GOOGLE_MAPS_API_KEY=
